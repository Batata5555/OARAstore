<script>
/* ---------------- Data ---------------- */
const PRODUCTS = [
  {id:1, title:'سوار السلسلة الذهبية', category:'Accessories', catLabel:'الإكسسوارات', price:690, oldPrice:810, rating:5, img:'https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=600&q=80', bf:true},
  {id:2, title:'محفظة جلدية سوداء أنيقة', category:'Accessories', catLabel:'الإكسسوارات', price:350, oldPrice:null, rating:4, img:'https://images.unsplash.com/photo-1627123424574-724758594e93?w=600&q=80', bf:false},
  {id:3, title:'نظارة شمسية ذهبية فاخرة', category:'Accessories', catLabel:'الإكسسوارات', price:530, oldPrice:620, rating:5, img:'https://images.unsplash.com/photo-1572635196237-14b3f281503f?w=600&q=80', bf:true},
  {id:4, title:'ساعة كرونوغراف ريجال', category:'Watches', catLabel:'الساعات', price:2350, oldPrice:2760, rating:5, img:'https://images.unsplash.com/photo-1524805444758-089113d48a6d?w=600&q=80', bf:true},
  {id:5, title:'ساعة أوتوماتيك أسود ملكي', category:'Watches', catLabel:'الساعات', price:1900, oldPrice:null, rating:4, img:'https://images.unsplash.com/photo-1547996160-81dfa63595aa?w=600&q=80', bf:false},
  {id:6, title:'ساعة كلاسيكية بسوار ذهبي', category:'Watches', catLabel:'الساعات', price:1500, oldPrice:1760, rating:5, img:'https://images.unsplash.com/photo-1523170335258-f5ed11844a49?w=600&q=80', bf:true},
  {id:7, title:'معطف كشمير أسود فاخر', category:'Clothing', catLabel:'الملابس', price:1390, oldPrice:null, rating:5, img:'https://images.unsplash.com/photo-1539533018447-63fcce2678e3?w=600&q=80', bf:false},
  {id:8, title:'بليزر مطرز بخيوط ذهبية', category:'Clothing', catLabel:'الملابس', price:1080, oldPrice:1270, rating:4, img:'https://images.unsplash.com/photo-1594938298603-c8148c4dae35?w=600&q=80', bf:true},
  {id:9, title:'وشاح حريري توقيع Oara', category:'Clothing', catLabel:'الملابس', price:440, oldPrice:null, rating:5, img:'https://images.unsplash.com/photo-1601924994987-69e26d50dc26?w=600&q=80', bf:false},
];

const INITIAL_REVIEWS = [
  {name:'أبو خالد', rating:5, text:'والله الساعة اللي طلبتها زي الصورة تمام، والتغليف كان مرتب كتير. التوصيل وصل نابلس خلال يومين بس.'},
  {name:'سارة', rating:4, text:'الشنطة حلوة وشكلها فخم، بس التوصيل تأخر شوي عن الموعد المتوقع. بشكل عام مبسوطة من الجودة.'},
  {name:'محمود ز.', rating:5, text:'تعاملت معهم على الواتساب وكانوا متجاوبين بسرعة، وسعر الخصم بمناسبة البلاك فرايدي كان يستاهل. رح اطلب تاني أكيد.'},
  {name:'ريم', rating:5, text:'الاسكارف اللي اخدته هدية لأمي عجبها كتير، الخامة ناعمة والألوان زي الصور بالظبط.'},
];

let cart = [];
let reviews = [...INITIAL_REVIEWS];
let activeCategory = 'all';
let discountRate = 0;
let appliedPromo = null;
let hasAccount = false;
let selectedRating = 0;

/* ---------------- Utilities ---------------- */
function money(n){ return n.toFixed(0) + ' ₪'; }

function starsHTML(rating, max=5){
  let html = '';
  for(let i=1;i<=max;i++){
    html += `<span class="${i<=rating ? '' : 'empty'}">★</span>`;
  }
  return html;
}

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 2600);
}

function scrollToTop(){ window.scrollTo({top:0, behavior:'smooth'}); }
function scrollToId(id){ document.getElementById(id).scrollIntoView({behavior:'smooth'}); }

/* ---------------- Rendering Products ---------------- */
function renderProducts(){
  const grid = document.getElementById('productGrid');
  const list = activeCategory === 'all' ? PRODUCTS : PRODUCTS.filter(p=>p.category===activeCategory);
  grid.innerHTML = list.map(p => `
    <div class="card">
      <div class="img-wrap">
        ${p.bf ? '<span class="badge">خصم 15% · بلاك فرايدي</span>' : ''}
        <img src="${p.img}" alt="${p.title}" loading="lazy">
      </div>
      <div class="card-body">
        <span class="card-cat">${p.catLabel}</span>
        <span class="card-title">${p.title}</span>
        <div class="stars">${starsHTML(p.rating)}</div>
        <div class="price-row">
          <span class="price">${money(p.price)}</span>
          ${p.oldPrice ? `<span class="price-old">${money(p.oldPrice)}</span>` : ''}
        </div>
        <button class="add-btn" onclick="addToCart(${p.id})">أضف إلى السلة</button>
      </div>
    </div>
  `).join('');
}

function filterCategory(cat, el){
  activeCategory = cat;
  document.querySelectorAll('.cat-tab').forEach(b=>b.classList.toggle('active', b.dataset.cat===cat));
  document.querySelectorAll('nav.main-nav button[data-cat]').forEach(b=>b.classList.toggle('active', b.dataset.cat===cat));
  document.querySelectorAll('nav.mobile-nav button[data-cat]').forEach(b=>b.classList.toggle('active', b.dataset.cat===cat));
  renderProducts();
}

/* ---------------- Cart Logic ---------------- */
function addToCart(id){
  const product = PRODUCTS.find(p=>p.id===id);
  const existing = cart.find(c=>c.id===id);
  if(existing){ existing.qty++; } else { cart.push({...product, qty:1}); }
  renderCart();
  updateCartCount();
  showToast(`تمت إضافة "${product.title}" إلى سلتك`);
  openCart();
  if(!hasAccount){
    setTimeout(()=>{ openAuthModal(); }, 550);
  }
}

function changeQty(id, delta){
  const item = cart.find(c=>c.id===id);
  if(!item) return;
  item.qty += delta;
  if(item.qty <= 0){ cart = cart.filter(c=>c.id!==id); }
  renderCart();
  updateCartCount();
}

function removeItem(id){
  cart = cart.filter(c=>c.id!==id);
  renderCart();
  updateCartCount();
}

function updateCartCount(){
  const count = cart.reduce((s,c)=>s+c.qty, 0);
  document.getElementById('cartCount').textContent = count;
}

function cartSubtotal(){ return cart.reduce((s,c)=>s + c.price*c.qty, 0); }

function renderCart(){
  const wrap = document.getElementById('drawerItems');
  if(cart.length === 0){
    wrap.innerHTML = '<div class="cart-empty">سلتك فارغة.<br>ابدأ بإضافة قطع من Oara.</div>';
  } else {
    wrap.innerHTML = cart.map(c => `
      <div class="cart-item">
        <img src="${c.img}" alt="${c.title}">
        <div class="ci-info">
          <div class="ci-title">${c.title}</div>
          <div class="ci-price">${money(c.price)}</div>
          <div class="qty-row">
            <button class="qty-btn" onclick="changeQty(${c.id},-1)">−</button>
            <span>${c.qty}</span>
            <button class="qty-btn" onclick="changeQty(${c.id},1)">+</button>
          </div>
          <a href="#" class="remove-btn" onclick="removeItem(${c.id});return false;">إزالة</a>
        </div>
      </div>
    `).join('');
  }
  const subtotal = cartSubtotal();
  const discount = subtotal * discountRate;
  const total = subtotal - discount;
  document.getElementById('sumSubtotal').textContent = money(subtotal);
  document.getElementById('sumTotal').textContent = money(total);
  if(discount > 0){
    document.getElementById('discountRow').style.display = 'flex';
    document.getElementById('sumDiscount').textContent = '-' + money(discount);
  } else {
    document.getElementById('discountRow').style.display = 'none';
  }
}

function applyPromo(){
  const code = document.getElementById('promoInput').value.trim().toUpperCase();
  const msg = document.getElementById('promoMsg');
  if(code === 'BLACKFRIDAY15'){
    discountRate = 0.15;
    appliedPromo = code;
    msg.textContent = 'تم تفعيل الكود — خصم 15% على طلبك!';
    msg.className = 'promo-msg ok';
  } else if(code === ''){
    msg.textContent = 'الرجاء إدخال كود الخصم.';
    msg.className = 'promo-msg err';
  } else {
    discountRate = 0;
    appliedPromo = null;
    msg.textContent = 'كود الخصم غير صحيح.';
    msg.className = 'promo-msg err';
  }
  renderCart();
}

/* ---------------- Overlays / Drawer / Modals ---------------- */
function openCart(){
  document.getElementById('cartDrawer').classList.add('open');
  document.getElementById('overlay').classList.add('show');
}
function closeCart(){
  document.getElementById('cartDrawer').classList.remove('open');
  document.getElementById('overlay').classList.remove('show');
}
function closeAllOverlays(){
  document.getElementById('cartDrawer').classList.remove('open');
  document.getElementById('authModal').classList.remove('show');
  document.getElementById('checkoutModal').classList.remove('show');
  document.getElementById('overlay').classList.remove('show');
}
function openAuthModal(){
  document.getElementById('authModal').classList.add('show');
  document.getElementById('overlay').classList.add('show');
}
function switchAuthTab(tab){
  document.getElementById('tabLogin').classList.toggle('active', tab==='login');
  document.getElementById('tabSignup').classList.toggle('active', tab==='signup');
}
function completeAuth(){
  const name = document.getElementById('authName').value.trim();
  if(!name){ showToast('الرجاء إدخال اسمك للمتابعة'); return; }
  hasAccount = true;
  document.getElementById('authModal').classList.remove('show');
  document.getElementById('overlay').classList.remove('show');
  showToast(`أهلاً بك، ${name} — تم حفظ سلتك!`);
}

function proceedToCheckout(){
  if(cart.length === 0){ showToast('سلتك فارغة'); return; }
  closeCart();
  openCheckout();
}

function openCheckout(){
  const summary = document.getElementById('checkoutSummary');
  const subtotal = cartSubtotal();
  const discount = subtotal * discountRate;
  const total = subtotal - discount;
  summary.innerHTML = cart.map(c => `
    <div class="co-item"><span>${c.title} × ${c.qty}</span><span>${money(c.price*c.qty)}</span></div>
  `).join('') + `
    <div class="co-item"><span>المجموع الفرعي</span><span>${money(subtotal)}</span></div>
    ${discount>0 ? `<div class="co-item"><span>الخصم (${appliedPromo})</span><span>-${money(discount)}</span></div>` : ''}
    <div class="co-item" style="border-top:1px solid var(--line);padding-top:10px;font-weight:700;"><span>الإجمالي</span><span>${money(total)}</span></div>
  `;
  document.getElementById('checkoutModal').classList.add('show');
  document.getElementById('overlay').classList.add('show');
}

function completeOrder(){
  if(cart.length === 0){ showToast('سلتك فارغة'); return; }
  const first = document.getElementById('coFirst').value.trim();
  const last = document.getElementById('coLast').value.trim();
  const city = document.getElementById('coCity').value;
  if(!first || !last || !city){
    showToast('الرجاء تعبئة جميع الحقول');
    return;
  }
  const subtotal = cartSubtotal();
  const discount = subtotal * discountRate;
  const total = subtotal - discount;

  let msg = `*طلب جديد - Oara Store*%0A`;
  msg += `*الاسم:* ${first} ${last}%0A`;
  msg += `*المدينة:* ${city}%0A`;
  msg += `%0A*المنتجات:*%0A`;
  cart.forEach(c => {
    msg += `- ${c.title} × ${c.qty} — ${money(c.price*c.qty)}%0A`;
  });
  msg += `%0A*المجموع الفرعي:* ${money(subtotal)}%0A`;
  if(discount>0){
    msg += `*كود الخصم:* ${appliedPromo} (-${money(discount)})%0A`;
  }
  msg += `*الإجمالي:* ${money(total)}`;

  const waUrl = `https://wa.me/972568486065?text=${msg}`;
  window.open(waUrl, '_blank');

  showToast('تم إرسال طلبك عبر واتساب!');
  closeAllOverlays();
  cart = [];
  discountRate = 0;
  appliedPromo = null;
  renderCart();
  updateCartCount();
}

/* ---------------- Reviews ---------------- */
function renderReviews(){
  const list = document.getElementById('reviewList');
  list.innerHTML = reviews.map(r => `
    <div class="review-card">
      <div class="review-top">
        <div class="reviewer">
          <div class="avatar">${r.name.charAt(0)}</div>
          <div class="reviewer-name">${r.name}</div>
        </div>
        <div class="stars">${starsHTML(r.rating)}</div>
      </div>
      <p class="review-text">${r.text}</p>
    </div>
  `).join('');
}

document.getElementById('starPicker').addEventListener('click', (e)=>{
  if(e.target.dataset.v){
    selectedRating = parseInt(e.target.dataset.v);
    document.querySelectorAll('#starPicker span').forEach(s=>{
      s.classList.toggle('on', parseInt(s.dataset.v) <= selectedRating);
    });
  }
});

function submitReview(){
  const name = document.getElementById('revName').value.trim();
  const text = document.getElementById('revText').value.trim();
  if(!name || !text || selectedRating===0){
    showToast('الرجاء تعبئة الاسم والتعليق واختيار التقييم');
    return;
  }
  reviews.unshift({name, rating:selectedRating, text});
  renderReviews();
  document.getElementById('revName').value = '';
  document.getElementById('revText').value = '';
  selectedRating = 0;
  document.querySelectorAll('#starPicker span').forEach(s=>s.classList.remove('on'));
  showToast('شكراً لك! تم نشر تقييمك');
}

/* ---------------- Mobile nav ---------------- */
function toggleMobileNav(){
  document.getElementById('mobileNav').classList.toggle('open');
}

/* ---------------- Init ---------------- */
renderProducts();
renderCart();
renderReviews();
</script>
</body>
</html>
